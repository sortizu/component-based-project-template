; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Node2D",
"class": "Component",
"language": "GDScript",
"path": "res://components/component.gd"
}, {
"base": "Node2D",
"class": "Entity",
"language": "GDScript",
"path": "res://entities/entity.gd"
}, {
"base": "Reference",
"class": "Logger",
"language": "GDScript",
"path": "res://addons/log_manager/logger.gd"
}, {
"base": "Node2D",
"class": "State",
"language": "GDScript",
"path": "res://components/state_manager/state.gd"
}, {
"base": "Component",
"class": "StateManager",
"language": "GDScript",
"path": "res://components/state_manager/state_manager.gd"
}, {
"base": "Component",
"class": "TestComponent",
"language": "GDScript",
"path": "res://test/test_component.gd"
} ]
_global_script_class_icons={
"Component": "",
"Entity": "",
"Logger": "",
"State": "",
"StateManager": "",
"TestComponent": ""
}

[application]

config/name="component-based-project-template"
run/main_scene="res://test/test_entity.tscn"
config/icon="res://icon.png"

[autoload]

GodotAPIHelpers="*res://addons/godot_api_helpers/godot_api_helpers.gd"
LogManager="*res://addons/log_manager/log_manager.gd"

[debug]

settings/gdscript/max_call_stack=10737418
settings/visual_script/max_call_stack=10737418

[editor_plugins]

enabled=PoolStringArray( "res://addons/godot_api_helpers/plugin.cfg", "res://addons/log_manager/plugin.cfg" )

[gui]

common/drop_mouse_on_gui_input_disabled=true
common/text_edit_undo_stack_max_size=10240

[network]

limits/debugger_stdout/max_chars_per_second=16384
limits/debugger_stdout/max_messages_per_frame=50

[physics]

common/enable_pause_aware_picking=true

[rendering]

environment/default_environment="res://default_env.tres"
